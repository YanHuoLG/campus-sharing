# Only send build inputs; exclude local databases, uploads, credentials and IDE files.
**
!Dockerfile
!.dockerignore
!pom.xml
!mvnw
!.mvn/
!.mvn/wrapper/
!.mvn/wrapper/maven-wrapper.properties
!src/
!src/**
src/main/resources/application-local.*
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
