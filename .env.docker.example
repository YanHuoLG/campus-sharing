# Copy to .env.docker and fill in the real connection details locally.
# mysql is an example container/service name, not an existing database.
DB_URL=jdbc:mysql://mysql:3306/campus_sharing?useUnicode=true&characterEncoding=UTF-8&connectionTimeZone=Asia/Shanghai
DB_USERNAME=campus_app
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
# Set true when clients access the application through HTTPS.
SESSION_COOKIE_SECURE=false
